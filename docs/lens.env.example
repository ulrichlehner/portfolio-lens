# Portfolio Lens configuration for local development. Copy to scratch/lens.env (gitignored)
# and replace the placeholders. Paths are relative to the repository root inside the container.
# Never put real values into this example file.

# Portfolio Performance REST API (Preferences > MCP Server & REST API > Add client)
LENS_PP_URL=http://127.0.0.1:5712
LENS_PP_TOKEN_FILE=scratch/pp-token
# LENS_PP_FILE=main

# Eulerpool, with your own key. The key has no effect without the confirmation below.
LENS_EULERPOOL_API_KEY_FILE=scratch/eulerpool-key
# Set to true only if your Eulerpool plan allows storing its data locally.
LENS_EULERPOOL_LOCAL_STORAGE_CONFIRMED=false

# Optional
# LENS_REGISTER_LOOKUP=true
# LENS_REPORTING_CURRENCY=EUR
# LENS_REQUEST_BUDGET=20000
# LENS_RUN_TIMEOUT=PT2M
